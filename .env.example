# Colapis agent key: Board Hub → AI & MCP → "Generate New Key" (col_sk_...)
COLAPIS_API_KEY=
# Your Colapis instance, without /api/mcp
COLAPIS_SERVER_URL=https://colapis.it

# Your own LLM key (bring your own key): deepseek, anthropic, openai, mistral or openrouter
LLM_PROVIDER=deepseek
LLM_API_KEY=
# Optional: the model (default: the provider's own)
# LLM_MODEL=deepseek-flash

# backlog_sync serve: the secret of the GitHub webhook (16 characters or more)
# GITHUB_WEBHOOK_SECRET=
# standup_reporter --slack: a Slack incoming webhook
# SLACK_WEBHOOK_URL=
